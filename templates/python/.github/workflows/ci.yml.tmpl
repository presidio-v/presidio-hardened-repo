name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

# Least privilege: read-only token for all jobs (OpenSSF Scorecard Token-Permissions).
permissions:
  contents: read

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.12"
      - run: pip install ruff
      - run: ruff check src/ tests/
      - run: ruff format --check src/ tests/
      - name: SPDX header guard
        run: python scripts/spdx_headers.py --check src/ tests/

  test:
    name: Test (Python ${{ matrix.python-version }})
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.10", "3.11", "3.12", "3.13"]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: ${{ matrix.python-version }}
      - name: Install dependencies
        run: pip install -e ".[dev]"
      # --cov-fail-under=90 enforces the gold statement floor. coverage.json is
      # emitted so the next step can enforce a per-metric branch floor (>= 80%),
      # which --cov-fail-under alone does not check.
      - name: Run tests
        run: pytest tests/ --cov={{PROJECT_PACKAGE}} --cov-branch --cov-report=xml --cov-report=json --cov-report=term --cov-fail-under=90
      - name: Enforce branch coverage floor (>= 80%)
        run: |
          python - <<'PY'
          import json
          import sys

          totals = json.load(open("coverage.json"))["totals"]
          branches = totals["num_branches"]
          branch = 100 * totals["covered_branches"] / branches if branches else 100.0
          print(f"branch coverage: {branch:.2f}%  (floor 80%)")
          if branch < 80:
              sys.exit(f"COVERAGE FAILURE: branch {branch:.2f}% < 80%")
          PY
      # coverage.xml is retained as a build artifact only; no external upload.
      - name: Upload coverage report
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: coverage-py${{ matrix.python-version }}
          path: coverage.xml

  lock-drift:
    name: Lockfile drift
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Install uv
        uses: astral-sh/setup-uv@11f9893b081a58869d3b5fccaea48c9e9e46f990 # v8.3.2
      - name: Verify uv.lock is up to date with pyproject.toml
        run: uv lock --locked

  security-audit:
    name: Dependency Security Audit
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Install uv
        uses: astral-sh/setup-uv@11f9893b081a58869d3b5fccaea48c9e9e46f990 # v8.3.2
      - name: Run pip-audit over the project's own extras
        # FILL:audit-extras append one `--extra <name>` argument per optional extra
        # declared in this project's pyproject.toml (e.g. `--extra otel --extra redis`)
        # so their transitive deps are audited; delete this note if there are none.
        run: uv run pip-audit --progress-spinner=off --skip-editable

  sbom:
    name: SBOM (CycloneDX)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.12"
      - name: Install package + SBOM tool
        run: |
          pip install -e .
          pip install cyclonedx-bom
      - name: Generate SBOM
        run: cyclonedx-py environment --output-format JSON --output-file sbom.cdx.json
      - name: Upload SBOM artifact
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: sbom
          path: sbom.cdx.json

  # OPTIONAL: coverage-guided fuzzing with Atheris. Uncomment to enable once the
  # project ships fuzz harnesses under fuzz/ and a `fuzz` extra in pyproject.toml.
  # Gotchas:
  #   - Atheris 3.x ships no cp310 wheel, so pin the job to Python 3.12 (not 3.10).
  #   - Atheris publishes no macOS wheel; this job only runs on ubuntu-latest.
